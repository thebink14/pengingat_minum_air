        // =========================================================================
        // 1. KONFIGURASI PENYIMPANAN GANDA (LOCALSTORAGE + INDEXEDDB)
        // =========================================================================
        const STORAGE_KEY_MASTER = 'pengingat_minum_persistent_v3';
        const LEGACY_KEYS = ['pengingat_minum_persistent_v2', 'pengingat_minum_data_v1'];
        const IDB_NAME = 'WorkspaceHidrasiFokusDB';
        const IDB_STORE = 'app_state_store';

        // Template Default Checklist "Tiap Kali Kerja Harus Ngapain Dulu"
        const DEFAULT_CHECKLIST_ITEMS = [
            { id: 'def_1', text: 'Siapkan segelas air putih / isi penuh tumbler di meja kerja', completed: false, category: 'routine' },
            { id: 'def_2', text: 'Cek jadwal & tentukan 3 prioritas pekerjaan utama hari ini', completed: false, category: 'routine' },
            { id: 'def_3', text: 'Buka workspace kerja & tutup tab browser yang mengganggu fokus', completed: false, category: 'routine' },
            { id: 'def_4', text: 'Aktifkan Timer Minum (1 Jam) & Fokus Mode (2 Jam)', completed: false, category: 'routine' },
            { id: 'def_5', text: 'Cek pesan/email penting sebelum masuk sesi deep work', completed: false, category: 'routine' }
        ];

        // State Utama Aplikasi
        let appState = {
            targetGlasses: 8,
            cupSizeMl: 250,
            drinkHistory: [],
            checklist: [...DEFAULT_CHECKLIST_ITEMS],
            checklistFilter: 'all', // 'all' | 'routine' | 'todo'
            // Timer Pengingat Minum (1 Jam = 3600 detik)
            timer: {
                intervalMinutes: 60,
                selectedDurationSeconds: 3600,
                remainingSeconds: 3600,
                isRunning: false,
                targetEndTime: null,
                isAlarmRinging: false
            },
            // Timer Fokus Kerja (2 Jam = 7200 detik) & Rest (30 Menit = 1800 detik)
            focusTimer: {
                phase: 'work', // 'work' (120 mnt) atau 'rest' (30 mnt)
                workMinutes: 120,
                restMinutes: 30,
                selectedDurationSeconds: 7200,
                remainingSeconds: 7200,
                isRunning: false,
                targetEndTime: null,
                isAlarmRinging: false,
                sessionsCompletedToday: 0,
                lastSessionDate: ''
            },
            settings: {
                isMuted: false,
                preventAccidentalClose: true,
                activeHistoryTab: 'today'
            },
            lastSavedAt: Date.now()
        };

        let masterLoopInterval = null;
        let alarmSoundLoop = null;
        let audioCtx = null;

        // =========================================================================
        // 2. INISIALISASI & RECOVERY DATA OTOMATIS SAAT HALAMAN DIBUKA
        // =========================================================================
        window.onload = async function () {
            lucide.createIcons();
            updateDateHeader();

            // Muat dari LocalStorage + Sinkronisasi Cadangan IndexedDB
            await loadPersistentStateWithRecovery();

            // Pastikan penghitung sesi fokus harian di-reset jika ganti hari
            checkFocusDailySessionReset();

            // Sinkronisasi seluruh komponen UI
            syncSoundButtonUI();
            syncPreventCloseUI();
            syncPresetButtonsUI();
            renderChecklistUI();
            renderHydrationUI();
            checkNotificationStatus();

            // Pulihkan jalannya kedua Timer (Minum & Fokus) jika sedang berjalan sebelum refresh/keluar
            restoreDrinkTimerOnReload();
            restoreFocusTimerOnReload();

            // Jalankan Master Loop setiap detik untuk update kedua timer + Auto-Save Real-Time
            if (masterLoopInterval) clearInterval(masterLoopInterval);
            masterLoopInterval = setInterval(masterTickAndAutoSave, 1000);
        };

        // Simpan instan saat tab disembunyikan/diminimalkan
        document.addEventListener('visibilitychange', function () {
            syncActiveTimersRemaining();
            savePersistentState(false);
        });

        // Simpan instan sebelum tab tertutup + cegah keluar tidak sengaja jika diaktifkan
        window.addEventListener('beforeunload', function (e) {
            syncActiveTimersRemaining();
            savePersistentState(false);

            const anyTimerRunning = appState.timer.isRunning || appState.focusTimer.isRunning;
            if (appState.settings.preventAccidentalClose && anyTimerRunning) {
                e.preventDefault();
                e.returnValue = 'Timer masih berjalan. Data sudah tersimpan otomatis, yakin ingin menutup halaman?';
                return e.returnValue;
            }
        });

        function syncActiveTimersRemaining() {
            const now = Date.now();
            if (appState.timer.isRunning && appState.timer.targetEndTime) {
                appState.timer.remainingSeconds = Math.max(0, Math.ceil((appState.timer.targetEndTime - now) / 1000));
            }
            if (appState.focusTimer.isRunning && appState.focusTimer.targetEndTime) {
                appState.focusTimer.remainingSeconds = Math.max(0, Math.ceil((appState.focusTimer.targetEndTime - now) / 1000));
            }
        }

        // IndexedDB Helper untuk lapis penyimpanan kedua (Anti-Hilang)
        function openIndexedDB() {
            return new Promise((resolve) => {
                if (!window.indexedDB) return resolve(null);
                const req = indexedDB.open(IDB_NAME, 1);
                req.onupgradeneeded = function (e) {
                    const db = e.target.result;
                    if (!db.objectStoreNames.contains(IDB_STORE)) {
                        db.createObjectStore(IDB_STORE);
                    }
                };
                req.onsuccess = function (e) { resolve(e.target.result); };
                req.onerror = function () { resolve(null); };
            });
        }

        async function saveToIndexedDB(stateData) {
            try {
                const db = await openIndexedDB();
                if (!db) return;
                const tx = db.transaction(IDB_STORE, 'readwrite');
                tx.objectStore(IDB_STORE).put(stateData, 'master_state');
            } catch (e) {
                // Abaikan jika IndexedDB diblokir mode privat tertentu
            }
        }

        async function readFromIndexedDB() {
            try {
                const db = await openIndexedDB();
                if (!db) return null;
                return new Promise((resolve) => {
                    const tx = db.transaction(IDB_STORE, 'readonly');
                    const req = tx.objectStore(IDB_STORE).get('master_state');
                    req.onsuccess = () => resolve(req.result || null);
                    req.onerror = () => resolve(null);
                });
            } catch (e) {
                return null;
            }
        }

        async function loadPersistentStateWithRecovery() {
            let loadedState = null;

            // 1. Coba baca dari LocalStorage terbaru
            try {
                const rawMaster = localStorage.getItem(STORAGE_KEY_MASTER);
                if (rawMaster) {
                    loadedState = JSON.parse(rawMaster);
                } else {
                    // Cek versi lama untuk migrasi mulus
                    for (const key of LEGACY_KEYS) {
                        const rawOld = localStorage.getItem(key);
                        if (rawOld) {
                            loadedState = JSON.parse(rawOld);
                            break;
                        }
                    }
                }
            } catch (err) {
                console.error("Gagal membaca LocalStorage:", err);
            }

            // 2. Bandingkan dengan cadangan di IndexedDB (ambil yang paling baru jika ada)
            const idbState = await readFromIndexedDB();
            if (idbState && (!loadedState || (idbState.lastSavedAt || 0) > (loadedState.lastSavedAt || 0))) {
                loadedState = idbState;
            }

            if (loadedState) {
                mergeLoadedState(loadedState);
            }
            savePersistentState(false);
        }

        function mergeLoadedState(parsed) {
            appState = {
                ...appState,
                ...parsed,
                timer: { ...appState.timer, ...(parsed.timer || {}) },
                focusTimer: { ...appState.focusTimer, ...(parsed.focusTimer || {}) },
                settings: { ...appState.settings, ...(parsed.settings || {}) },
                drinkHistory: Array.isArray(parsed.drinkHistory) ? parsed.drinkHistory : [],
                checklist: Array.isArray(parsed.checklist) && parsed.checklist.length > 0
                    ? parsed.checklist
                    : [...DEFAULT_CHECKLIST_ITEMS]
            };
        }

        function savePersistentState(animateBadge = true) {
            try {
                appState.lastSavedAt = Date.now();
                const serialized = JSON.stringify(appState);
                localStorage.setItem(STORAGE_KEY_MASTER, serialized);
                saveToIndexedDB(appState);

                const timeStr = new Date(appState.lastSavedAt).toLocaleTimeString('id-ID', {
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });
                const lastSavedEl = document.getElementById('lastSavedTimeText');
                if (lastSavedEl) {
                    lastSavedEl.textContent = `Tersimpan otomatis: ${timeStr}`;
                }

                if (animateBadge) {
                    const badge = document.getElementById('saveStatusBadge');
                    if (badge) {
                        badge.classList.add('scale-105');
                        setTimeout(() => badge.classList.remove('scale-105'), 180);
                    }
                }
            } catch (err) {
                console.error("Gagal menyimpan state:", err);
            }
        }

        // Master Tick 1 Detik: Mengelola kedua timer & Auto-Save periodik
        function masterTickAndAutoSave() {
            let stateChanged = false;

            if (appState.timer.isRunning) {
                tickDrinkTimer();
                stateChanged = true;
            }
            if (appState.focusTimer.isRunning) {
                tickFocusTimer();
                stateChanged = true;
            }

            updatePageTitleDynamic();

            // Tetap simpan ke storage setiap detik saat timer jalan agar anti-reset
            if (stateChanged) {
                savePersistentState(false);
            }
        }

        function updatePageTitleDynamic() {
            if (appState.timer.isAlarmRinging) {
                document.title = "🔔 WAKTUNYA MINUM AIR! 💧";
                return;
            }
            if (appState.focusTimer.isAlarmRinging) {
                document.title = appState.focusTimer.phase === 'work'
                    ? "☕ WAKTUNYA ISTIRAHAT 30 MENIT!"
                    : "🔥 WAKTUNYA KEMBALI FOKUS!";
                return;
            }

            const parts = [];
            if (appState.focusTimer.isRunning) {
                const icon = appState.focusTimer.phase === 'work' ? '🔥' : '☕';
                parts.push(`${icon} ${formatCompactTime(appState.focusTimer.remainingSeconds)}`);
            }
            if (appState.timer.isRunning) {
                parts.push(`💧 ${formatCompactTime(appState.timer.remainingSeconds)}`);
            }

            if (parts.length > 0) {
                document.title = `${parts.join(' | ')} - Workspace Kerja`;
            } else {
                document.title = "Workspace Hidrasi & Fokus Kerja 💧🔥";
            }
        }

        function formatCompactTime(totalSecs) {
            const hrs = Math.floor(totalSecs / 3600);
            const mins = Math.floor((totalSecs % 3600) / 60);
            const secs = totalSecs % 60;
            if (hrs > 0) {
                return `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            }
            return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        }

        function getTodayDateString() {
            const now = new Date();
            return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
        }

        function getFormattedShortDate(dateObj = new Date()) {
            return dateObj.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
        }

        function updateDateHeader() {
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('currentDateDisplay').textContent = new Date().toLocaleDateString('id-ID', options);
        }

        // =========================================================================
        // 3. FITUR CHECKLIST PERSIAPAN KERJA & TO-DO HARIAN
        // =========================================================================
        function handleAddTask(e) {
            e.preventDefault();
            const input = document.getElementById('newTaskInput');
            const text = input.value.trim();
            if (!text) return;

            const categoryRadio = document.querySelector('input[name="taskCategory"]:checked');
            const category = categoryRadio ? categoryRadio.value : 'routine';

            const newItem = {
                id: 'task_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6),
                text: text,
                completed: false,
                category: category
            };

            appState.checklist.push(newItem);
            input.value = '';
            savePersistentState(true);
            renderChecklistUI();
            showToast("Item checklist berhasil ditambahkan & disimpan!");
        }

        function toggleChecklistItem(itemId) {
            const item = appState.checklist.find(t => t.id === itemId);
            if (!item) return;
            item.completed = !item.completed;
            savePersistentState(true);
            renderChecklistUI();
        }

        function deleteChecklistItem(itemId) {
            appState.checklist = appState.checklist.filter(t => t.id !== itemId);
            savePersistentState(true);
            renderChecklistUI();
            showToast("Item checklist dihapus.");
        }

        function moveChecklistItem(itemId, direction) {
            const idx = appState.checklist.findIndex(t => t.id === itemId);
            if (idx === -1) return;
            const targetIdx = idx + direction;
            if (targetIdx < 0 || targetIdx >= appState.checklist.length) return;

            const temp = appState.checklist[idx];
            appState.checklist[idx] = appState.checklist[targetIdx];
            appState.checklist[targetIdx] = temp;

            savePersistentState(true);
            renderChecklistUI();
        }

        function uncheckAllRoutineTasks() {
            appState.checklist.forEach(item => {
                item.completed = false;
            });
            savePersistentState(true);
            renderChecklistUI();
            showToast("Semua tanda ceklis di-reset untuk sesi kerja baru!");
        }

        function restoreDefaultRoutineTasks() {
            const existingTexts = new Set(appState.checklist.map(i => i.text.toLowerCase()));
            let added = 0;
            DEFAULT_CHECKLIST_ITEMS.forEach(def => {
                if (!existingTexts.has(def.text.toLowerCase())) {
                    appState.checklist.push({
                        ...def,
                        id: 'def_' + Date.now() + '_' + Math.random().toString(36).substring(2, 5)
                    });
                    added++;
                }
            });
            savePersistentState(true);
            renderChecklistUI();
            showToast(added > 0 ? `${added} ritual kerja standar ditambahkan!` : "Semua ritual standar sudah ada di daftar.");
        }

        function clearCompletedTodos() {
            const beforeCount = appState.checklist.length;
            // Hanya hapus kategori 'todo' yang sudah selesai, ritual tetap disimpan tapi di-uncheck
            appState.checklist = appState.checklist.filter(item => !(item.category === 'todo' && item.completed));
            const removed = beforeCount - appState.checklist.length;
            savePersistentState(true);
            renderChecklistUI();
            showToast(removed > 0 ? `${removed} tugas selesai dibersihkan.` : "Tidak ada tugas harian selesai untuk dihapus.");
        }

        function switchChecklistFilter(filter) {
            appState.checklistFilter = filter;
            savePersistentState(false);
            renderChecklistUI();
        }

        function renderChecklistUI() {
            const allTasks = appState.checklist;
            const routineTasks = allTasks.filter(t => t.category === 'routine');
            const todoTasks = allTasks.filter(t => t.category === 'todo');

            // Update counter pada tab
            document.getElementById('badgeCountAllTasks').textContent = allTasks.length;
            document.getElementById('badgeCountRoutineTasks').textContent = routineTasks.length;
            document.getElementById('badgeCountTodoTasks').textContent = todoTasks.length;

            // Highlight Tab Aktif
            const activeTabClass = "flex-1 text-xs font-bold py-1.5 px-2 rounded-lg bg-white text-cobalt shadow-sm transition-all";
            const inactiveTabClass = "flex-1 text-xs font-semibold py-1.5 px-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all";
            document.getElementById('tabChecklistRoutine').className = appState.checklistFilter === 'all' ? activeTabClass : inactiveTabClass;
            document.getElementById('tabChecklistRitual').className = appState.checklistFilter === 'routine' ? activeTabClass : inactiveTabClass;
            document.getElementById('tabChecklistTodo').className = appState.checklistFilter === 'todo' ? activeTabClass : inactiveTabClass;

            // Hitung Progres Keseluruhan
            const completedCount = allTasks.filter(t => t.completed).length;
            const totalCount = allTasks.length;
            const pct = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;

            document.getElementById('checklistProgressCount').textContent = `${completedCount}/${totalCount} Selesai (${pct}%)`;
            document.getElementById('checklistProgressBar').style.width = `${pct}%`;

            const motEl = document.getElementById('checklistMotivationText');
            if (totalCount === 0) {
                motEl.textContent = "Tambahkan ritual persiapan kerjamu di bawah.";
            } else if (pct === 100) {
                motEl.textContent = "Mantap! Semua persiapan & tugas beres — siap fokus penuh! 🚀";
            } else if (pct >= 50) {
                motEl.textContent = "Lebih dari separuh jalan! Selesaikan sisanya.";
            } else {
                motEl.textContent = "Yuk ceklis satu per satu ritual sebelum mulai kerja.";
            }

            // Filter daftar yang ditampilkan
            let filtered = allTasks;
            if (appState.checklistFilter === 'routine') filtered = routineTasks;
            if (appState.checklistFilter === 'todo') filtered = todoTasks;

            const container = document.getElementById('checklistContainer');
            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-6 px-3 text-xs text-slate-400 bg-slate-50/70 rounded-2xl border border-dashed border-slate-200">
                        Belum ada item di kategori ini. Tambahkan di kolom atas!
                    </div>
                `;
                return;
            }

            container.innerHTML = filtered.map((item) => {
                const badgeHtml = item.category === 'routine'
                    ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">Ritual Kerja</span>`
                    : `<span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-blue-50 text-cobalt border border-cobalt-border">Tugas</span>`;

                return `
                    <div class="flex items-start justify-between gap-2.5 p-3 rounded-2xl border ${item.completed ? 'bg-slate-50/60 border-slate-200/60' : 'bg-white border-slate-200 hover:border-cobalt/40'} transition-all group">
                        <label class="flex items-start gap-2.5 flex-1 cursor-pointer select-none">
                            <input type="checkbox" ${item.completed ? 'checked' : ''} onchange="toggleChecklistItem('${item.id}')"
                                class="checkbox-custom mt-0.5 w-4 h-4 rounded text-emerald-600 border-slate-300 focus:ring-emerald-500 cursor-pointer">
                            <div class="flex-1 text-xs font-semibold text-slate-800 leading-snug">
                                <span>${escapeHtml(item.text)}</span>
                                <div class="mt-1">${badgeHtml}</div>
                            </div>
                        </label>
                        <div class="flex items-center gap-0.5 opacity-80 group-hover:opacity-100">
                            <button onclick="moveChecklistItem('${item.id}', -1)" class="p-1 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100" title="Geser ke atas">
                                <i data-lucide="chevron-up" class="w-3.5 h-3.5"></i>
                            </button>
                            <button onclick="moveChecklistItem('${item.id}', 1)" class="p-1 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100" title="Geser ke bawah">
                                <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                            </button>
                            <button onclick="deleteChecklistItem('${item.id}')" class="p-1 rounded-lg text-slate-300 hover:text-rose-600 hover:bg-rose-50" title="Hapus">
                                <i data-lucide="x" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
            lucide.createIcons();
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        // =========================================================================
        // 4. FITUR FOKUS MODE (2 JAM KERJA / 120 MNT) & REST (30 MENIT)
        // =========================================================================
        function checkFocusDailySessionReset() {
            const today = getTodayDateString();
            if (appState.focusTimer.lastSessionDate !== today) {
                appState.focusTimer.sessionsCompletedToday = 0;
                appState.focusTimer.lastSessionDate = today;
                savePersistentState(false);
            }
        }

        function restoreFocusTimerOnReload() {
            if (appState.focusTimer.isAlarmRinging) {
                appState.focusTimer.remainingSeconds = 0;
                updateFocusTimerUI();
                triggerFocusAlarm();
                return;
            }

            if (appState.focusTimer.isRunning && appState.focusTimer.targetEndTime) {
                const diff = Math.ceil((appState.focusTimer.targetEndTime - Date.now()) / 1000);
                if (diff > 0) {
                    appState.focusTimer.remainingSeconds = diff;
                    updateFocusTimerUI();
                } else {
                    appState.focusTimer.remainingSeconds = 0;
                    updateFocusTimerUI();
                    triggerFocusAlarm();
                }
            } else {
                updateFocusTimerUI();
            }
        }

        function switchFocusPhase(newPhase, autoStart = false) {
            pauseFocusTimer(false);
            appState.focusTimer.phase = newPhase;
            appState.focusTimer.isAlarmRinging = false;

            const minutes = newPhase === 'work' ? appState.focusTimer.workMinutes : appState.focusTimer.restMinutes;
            appState.focusTimer.selectedDurationSeconds = minutes * 60;
            appState.focusTimer.remainingSeconds = minutes * 60;
            appState.focusTimer.targetEndTime = null;

            updateFocusTimerUI();
            savePersistentState(true);

            if (autoStart) {
                startFocusTimer();
            }
        }

        function toggleFocusTimer() {
            initAudioContext();
            if (appState.focusTimer.isRunning) {
                pauseFocusTimer(true);
            } else {
                startFocusTimer();
            }
        }

        function startFocusTimer() {
            if (appState.focusTimer.remainingSeconds <= 0) {
                const mins = appState.focusTimer.phase === 'work' ? appState.focusTimer.workMinutes : appState.focusTimer.restMinutes;
                appState.focusTimer.selectedDurationSeconds = mins * 60;
                appState.focusTimer.remainingSeconds = mins * 60;
            }
            appState.focusTimer.isRunning = true;
            appState.focusTimer.isAlarmRinging = false;
            appState.focusTimer.targetEndTime = Date.now() + (appState.focusTimer.remainingSeconds * 1000);

            updateFocusTimerUI();
            savePersistentState(true);
        }

        function pauseFocusTimer(save = true) {
            if (appState.focusTimer.isRunning && appState.focusTimer.targetEndTime) {
                appState.focusTimer.remainingSeconds = Math.max(0, Math.ceil((appState.focusTimer.targetEndTime - Date.now()) / 1000));
            }
            appState.focusTimer.isRunning = false;
            appState.focusTimer.targetEndTime = null;

            updateFocusTimerUI();
            if (save) savePersistentState(true);
        }

        function resetFocusTimer() {
            pauseFocusTimer(false);
            const mins = appState.focusTimer.phase === 'work' ? appState.focusTimer.workMinutes : appState.focusTimer.restMinutes;
            appState.focusTimer.selectedDurationSeconds = mins * 60;
            appState.focusTimer.remainingSeconds = mins * 60;
            appState.focusTimer.isAlarmRinging = false;
            updateFocusTimerUI();
            savePersistentState(true);
            showToast("Timer Fokus/Rest berhasil di-reset.");
        }

        function skipFocusPhase() {
            const nextPhase = appState.focusTimer.phase === 'work' ? 'rest' : 'work';
            switchFocusPhase(nextPhase, false);
            showToast(nextPhase === 'rest' ? "Berpindah ke Mode Istirahat (30 Menit) ☕" : "Berpindah ke Mode Fokus Kerja (2 Jam) 🔥");
        }

        function setFocusTest5Sec() {
            pauseFocusTimer(false);
            appState.focusTimer.selectedDurationSeconds = 5;
            appState.focusTimer.remainingSeconds = 5;
            startFocusTimer();
            showToast("Simulasi Fokus/Rest 5 detik dimulai!");
        }

        function tickFocusTimer() {
            if (!appState.focusTimer.isRunning || !appState.focusTimer.targetEndTime) return;
            const diff = Math.ceil((appState.focusTimer.targetEndTime - Date.now()) / 1000);
            if (diff > 0) {
                appState.focusTimer.remainingSeconds = diff;
                updateFocusTimerUI();
            } else {
                appState.focusTimer.remainingSeconds = 0;
                updateFocusTimerUI();
                triggerFocusAlarm();
            }
        }

        function updateFocusTimerUI() {
            const ft = appState.focusTimer;
            const isWork = ft.phase === 'work';

            // Tampilan angka waktu
            const totalSecs = Math.max(0, ft.remainingSeconds);
            const hrs = Math.floor(totalSecs / 3600);
            const mins = Math.floor((totalSecs % 3600) / 60);
            const secs = totalSecs % 60;
            document.getElementById('focusCountdownDisplay').textContent =
                `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

            // Counter sesi hari ini
            document.getElementById('focusSessionsTodayCount').textContent = ft.sessionsCompletedToday || 0;

            // Badge & Warna Tema Fokus vs Rest
            const badge = document.getElementById('focusModeBadge');
            const modeLabel = document.getElementById('focusModeLabel');
            const modeIcon = document.getElementById('focusModeIcon');
            const progressBar = document.getElementById('focusProgressBar');
            const btnWork = document.getElementById('btnSelectFocusMode');
            const btnRest = document.getElementById('btnSelectRestMode');
            const startBtn = document.getElementById('btnFocusStartPause');
            const startText = document.getElementById('focusStartPauseText');
            const startIcon = document.getElementById('focusStartPauseIcon');
            const nextInfo = document.getElementById('focusNextInfoText');

            if (isWork) {
                badge.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200";
                modeLabel.textContent = "Mode Fokus Kerja (2 Jam)";
                modeIcon.setAttribute('data-lucide', 'flame');
                progressBar.className = "h-full bg-indigo-600 rounded-full transition-all duration-300";

                btnWork.className = "py-1.5 px-3 rounded-lg text-xs font-bold bg-white text-indigo-700 shadow-sm flex items-center justify-center gap-1.5 transition-all";
                btnRest.className = "py-1.5 px-3 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 flex items-center justify-center gap-1.5 transition-all";
            } else {
                badge.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200";
                modeLabel.textContent = "Mode Istirahat / Rest (30 Mnt)";
                modeIcon.setAttribute('data-lucide', 'coffee');
                progressBar.className = "h-full bg-emerald-500 rounded-full transition-all duration-300";

                btnRest.className = "py-1.5 px-3 rounded-lg text-xs font-bold bg-white text-emerald-700 shadow-sm flex items-center justify-center gap-1.5 transition-all";
                btnWork.className = "py-1.5 px-3 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 flex items-center justify-center gap-1.5 transition-all";
            }

            // Progress Bar Width
            const totalDur = ft.selectedDurationSeconds || (isWork ? 7200 : 1800);
            const pct = Math.min(100, Math.max(0, (totalSecs / totalDur) * 100));
            progressBar.style.width = `${pct}%`;

            // Tombol Mulai / Jeda Fokus
            if (ft.isRunning) {
                startBtn.className = "col-span-2 py-2.5 px-4 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs shadow-md shadow-amber-500/20 flex items-center justify-center gap-1.5 transition-all";
                startText.textContent = "Jeda";
                startIcon.setAttribute('data-lucide', 'pause');

                if (ft.targetEndTime) {
                    const endStr = new Date(ft.targetEndTime).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                    nextInfo.textContent = isWork
                        ? `Fokus berjalan • Jadwal istirahat pukul ${endStr}`
                        : `Istirahat berjalan • Kembali kerja pukul ${endStr}`;
