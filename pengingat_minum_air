                                <span class="w-6 h-6 rounded-lg bg-cobalt-light text-cobalt font-extrabold flex items-center justify-center text-[10px]">
                                    #${logsToDisplay.length - idx}
                                </span>
                                <div>
                                    <div class="font-bold text-slate-800 flex items-center gap-1.5">
                                        <span>+${item.ml} ml</span>
                                        <span class="text-[11px] font-medium text-slate-400">• ${escapeHtml(item.note || 'Air Putih')}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-400 font-medium">
                                        ${badgeDate}, Pukul ${item.time}
                                    </div>
                                </div>
                            </div>
                            <button onclick="deleteSingleHistoryEntry('${item.id}')" class="p-1 rounded-lg text-slate-300 hover:text-rose-600 hover:bg-rose-50 transition-all" title="Hapus catatan ini">
                                <i data-lucide="x" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    `;
                }).join('');
                lucide.createIcons();
            }
        }

        // =========================================================================
        // 8. BACKUP & RESTORE DATA (.JSON) SERTA MODAL PENGATURAN
        // =========================================================================
        function openBackupModal() {
            const modal = document.getElementById('backupModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeBackupModal() {
            const modal = document.getElementById('backupModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function downloadBackupJson() {
            syncActiveTimersRemaining();
            savePersistentState(false);

            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState, null, 2));
            const downloadAnchor = document.createElement('a');
            const dateStr = getTodayDateString();
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `backup_hidrasi_fokus_${dateStr}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();

            showToast("File cadangan (.json) berhasil diunduh!");
        }

        function handleRestoreFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    mergeLoadedState(imported);
                    savePersistentState(true);

                    syncSoundButtonUI();
                    syncPreventCloseUI();
                    syncPresetButtonsUI();
                    renderChecklistUI();
                    renderHydrationUI();
                    restoreDrinkTimerOnReload();
                    restoreFocusTimerOnReload();

                    closeBackupModal();
                    showToast("Data berhasil dipulihkan dari file cadangan!");
                } catch (err) {
                    showToast("Format file JSON tidak valid.");
                }
            };
            reader.readAsText(file);
        }

        function exportHistoryData() {
            if (appState.drinkHistory.length === 0) {
                showToast("Belum ada riwayat minum untuk disalin.");
                return;
            }
            const lines = appState.drinkHistory.map((item, idx) =>
                `${idx + 1}. [${item.dateLabel || item.date} - ${item.time}] +${item.ml} ml (${item.note || 'Air Putih'})`
            );
            const summaryText = `Riwayat Hidrasi (${appState.drinkHistory.length} Catatan):\n` + lines.join('\n');

            const tempArea = document.createElement('textarea');
            tempArea.value = summaryText;
            document.body.appendChild(tempArea);
            tempArea.select();
            document.execCommand('copy');
            document.body.removeChild(tempArea);

            showToast("Ringkasan riwayat berhasil disalin ke Clipboard!");
        }

        function openConfirmClearModal() {
            const modal = document.getElementById('confirmClearModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeConfirmClearModal() {
            const modal = document.getElementById('confirmClearModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function clearHistoryTodayOnly() {
            const todayStr = getTodayDateString();
            appState.drinkHistory = appState.drinkHistory.filter(item => item.date !== todayStr);
            savePersistentState(true);
            renderHydrationUI();
            closeConfirmClearModal();
            showToast("Catatan minum hari ini telah direset.");
        }

        function clearAllHistoryData() {
            appState.drinkHistory = [];
            savePersistentState(true);
            renderHydrationUI();
            closeConfirmClearModal();
            showToast("Seluruh riwayat minum telah dihapus.");
        }

        // Modal Target Hidrasi
        let tempTargetGlasses = 8;
        let tempCupSizeMl = 250;

        function openTargetModal() {
            tempTargetGlasses = appState.targetGlasses || 8;
            tempCupSizeMl = appState.cupSizeMl || 250;
            updateTargetModalUI();
            const modal = document.getElementById('targetModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeTargetModal() {
            const modal = document.getElementById('targetModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function adjustTargetInput(delta) {
            tempTargetGlasses = Math.max(1, Math.min(25, tempTargetGlasses + delta));
            updateTargetModalUI();
        }

        function selectModalCupSize(sizeMl) {
            tempCupSizeMl = sizeMl;
            updateTargetModalUI();
        }

        function updateTargetModalUI() {
            document.getElementById('modalTargetValue').textContent = tempTargetGlasses;
            document.getElementById('modalTargetMl').textContent = `${tempTargetGlasses * tempCupSizeMl} ml`;

            document.querySelectorAll('.cup-size-btn').forEach(btn => {
                if (Number(btn.dataset.size) === tempCupSizeMl) {
                    btn.className = "cup-size-btn py-2 rounded-xl border border-cobalt bg-cobalt-light text-cobalt text-xs font-bold transition-all";
                } else {
                    btn.className = "cup-size-btn py-2 rounded-xl border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-bold transition-all";
                }
            });
        }

        function saveTargetModal() {
            appState.targetGlasses = tempTargetGlasses;
            appState.cupSizeMl = tempCupSizeMl;
            savePersistentState(true);
            renderHydrationUI();
            closeTargetModal();
            showToast(`Target disimpan: ${tempTargetGlasses} gelas (${tempTargetGlasses * tempCupSizeMl} ml/hari).`);
        }

        // Toast Helper
        let toastTimeout = null;
        function showToast(message) {
            const toast = document.getElementById('toastBox');
            document.getElementById('toastMessage').textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            if (toastTimeout) clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3200);
        }

        // =========================================================================
        // 9. UI CONTROLLER UNTUK AKUN CLOUD SYNC (GLOBAL HANDLERS)
        // =========================================================================
        const ACCOUNT_META_KEY = 'pengingat_minum_cloud_account_v1';
        let cloudAccountMeta = {
            accountId: '',
            pinHash: '',
            rawPinPreview: '',
            isConnected: false,
            lastCloudSyncAt: null
        };

        function loadSavedAccountMeta() {
            try {
                const raw = localStorage.getItem(ACCOUNT_META_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    cloudAccountMeta = { ...cloudAccountMeta, ...parsed };
                }
            } catch (e) {
                console.error("Gagal memuat metadata akun:", e);
            }
            updateAccountBadgeUI();
        }

        function saveAccountMeta() {
            try {
                localStorage.setItem(ACCOUNT_META_KEY, JSON.stringify(cloudAccountMeta));
            } catch (e) {}
            updateAccountBadgeUI();
        }

        function normalizeAccountKey(accountId, pin) {
            const cleanId = String(accountId || '')
                .trim()
                .toLowerCase()
                .replace(/[^a-z0-9_-]/g, '-');
            const cleanPin = String(pin || '').trim();
            if (!cleanId) return '';
            if (!cleanPin) return `acc_${cleanId}`;
            // Simple deterministic hash untuk mengunci dokumen dengan PIN
            let hash = 0;
            const combo = `${cleanId}::${cleanPin}`;
            for (let i = 0; i < combo.length; i++) {
                hash = ((hash << 5) - hash) + combo.charCodeAt(i);
                hash |= 0;
            }
            return `acc_${cleanId}_p${Math.abs(hash)}`;
        }

        function openAccountModal() {
            loadSavedAccountMeta();
            const idInput = document.getElementById('syncAccountIdInput');
            const pinInput = document.getElementById('syncAccountPinInput');
            if (idInput) idInput.value = cloudAccountMeta.accountId || '';
            if (pinInput) pinInput.value = cloudAccountMeta.rawPinPreview || '';

            const modal = document.getElementById('accountModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            lucide.createIcons();
        }

        function closeAccountModal() {
            const modal = document.getElementById('accountModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function updateAccountBadgeUI() {
            const badgeText = document.getElementById('accountBadgeText');
            const activeLabel = document.getElementById('currentActiveAccountLabel');
            const logoutSection = document.getElementById('logoutAccountSection');
            const footerInfo = document.getElementById('footerSyncInfo');

            if (cloudAccountMeta.isConnected && cloudAccountMeta.accountId) {
                if (badgeText) badgeText.textContent = `Akun: ${cloudAccountMeta.accountId}`;
                if (activeLabel) activeLabel.textContent = `${cloudAccountMeta.accountId} (Tersinkron Cloud)`;
                if (logoutSection) {
                    logoutSection.classList.remove('hidden');
                    logoutSection.classList.add('flex');
                }
                if (footerInfo) {
                    footerInfo.innerHTML = `Terhubung ke Akun Cloud <b>"${escapeHtml(cloudAccountMeta.accountId)}"</b>. Buka halaman ini di perangkat lain & masukkan ID Akun yang sama untuk sinkronisasi otomatis.`;
                }
            } else {
                if (badgeText) badgeText.textContent = 'Akun Sync: Lokal';
                if (activeLabel) activeLabel.textContent = 'Mode Lokal (Belum Terhubung Cloud)';
                if (logoutSection) {
                    logoutSection.classList.add('hidden');
                    logoutSection.classList.remove('flex');
                }
                if (footerInfo) {
                    footerInfo.innerHTML = `Klik tombol <b>"Akun Sync"</b> di kanan atas untuk memasukkan ID Akun agar timer, checklist, dan riwayat otomatis tersinkron saat ganti laptop/HP.`;
                }
            }
        }

        function handleConnectCloudAccount(e) {
            e.preventDefault();
            const rawId = document.getElementById('syncAccountIdInput').value.trim();
            const rawPin = document.getElementById('syncAccountPinInput').value.trim();
            if (!rawId || rawId.length < 3) {
                showToast("ID Akun minimal 3 karakter.");
                return;
            }

            const docKey = normalizeAccountKey(rawId, rawPin);
            cloudAccountMeta.accountId = rawId.toLowerCase().replace(/[^a-z0-9_-]/g, '-');
            cloudAccountMeta.pinHash = docKey;
            cloudAccountMeta.rawPinPreview = rawPin;
            cloudAccountMeta.isConnected = true;
            saveAccountMeta();

            if (typeof window.connectToCloudDocument === 'function') {
                window.connectToCloudDocument(docKey, true);
            } else {
                showToast("Profil Akun disimpan! Akan otomatis tersinkron saat terhubung ke server.");
            }
            closeAccountModal();
        }

        function disconnectCloudAccount() {
            if (typeof window. stopCloudSubscription === 'function') {
                window.stopCloudSubscription();
            }
            cloudAccountMeta = {
                accountId: '',
                pinHash: '',
                rawPinPreview: '',
                isConnected: false,
                lastCloudSyncAt: null
            };
            saveAccountMeta();
            closeAccountModal();
            showToast("Akun Cloud diputuskan di perangkat ini. Data lokal tetap aman.");
        }

        function forcePushToCloudNow() {
            if (!cloudAccountMeta.isConnected || !cloudAccountMeta.pinHash) {
                showToast("Masukkan ID Akun dan klik Hubungkan terlebih dahulu!");
                return;
            }
            if (typeof window.pushStateToCloud === 'function') {
                window.pushStateToCloud(true);
            }
        }

        function forcePullFromCloudNow() {
            if (!cloudAccountMeta.isConnected || !cloudAccountMeta.pinHash) {
                showToast("Masukkan ID Akun dan klik Hubungkan terlebih dahulu!");
                return;
            }
            if (typeof window.pullStateFromCloud === 'function') {
                window.pullStateFromCloud(true);
            }
        }

        // Hook ke savePersistentState agar setiap perubahan langsung dikirim ke Cloud (debounced)
        const originalSavePersistentState = savePersistentState;
        let cloudPushDebounceTimer = null;
        savePersistentState = function (animateBadge = true) {
            originalSavePersistentState(animateBadge);
            if (cloudAccountMeta.isConnected && typeof window.pushStateToCloud === 'function') {
                if (cloudPushDebounceTimer) clearTimeout(cloudPushDebounceTimer);
                cloudPushDebounceTimer = setTimeout(() => {
                    window.pushStateToCloud(false);
                }, 650);
            }
        };

        // Muat metadata akun saat startup
        loadSavedAccountMeta();
    </script>

    <!-- =========================================================================
         10. MODUL FIREBASE CLOUD SYNC (REAL-TIME CROSS-DEVICE SYNC)
         ========================================================================= -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        let db = null;
        let auth = null;
        let currentUser = null;
        let activeUnsubscribe = null;
        let isApplyingRemoteUpdate = false;
        let lastPushedTimestamp = 0;

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'workspace-hidrasi-fokus-app';

        async function initFirebaseCloudSync() {
            const statusEl = document.getElementById('cloudConnectionStatus');
            const uidEl = document.getElementById('deviceUidDisplay');

            try {
                if (typeof __firebase_config === 'undefined' || !__firebase_config) {
                    if (statusEl) {
                        statusEl.className = "font-bold text-amber-600 flex items-center gap-1";
                        statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500"></span> Mode Offline / File Lokal`;
                    }
                    return;
                }

                const firebaseConfig = JSON.parse(__firebase_config);
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                // RULE 3: Auth Before Queries
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, (user) => {
                    currentUser = user;
                    if (user && uidEl) {
                        uidEl.textContent = user.uid;
                    }
                    if (user && statusEl) {
                        statusEl.className = "font-bold text-emerald-600 flex items-center gap-1";
                        statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Terhubung ke Cloud`;
                    }

                    // Jika sebelumnya sudah login ke ID Akun tertentu, otomatis sambungkan ulang
                    if (user && cloudAccountMeta.isConnected && cloudAccountMeta.pinHash) {
                        connectToCloudDocument(cloudAccountMeta.pinHash, false);
                    }
                });
            } catch (err) {
                console.error("Inisialisasi Cloud Sync gagal:", err);
                if (statusEl) {
                    statusEl.className = "font-bold text-amber-600 flex items-center gap-1";
                    statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500"></span> Penyimpanan Lokal Aktif`;
                }
            }
        }

        // Fungsi menghubungkan ke dokumen akun di koleksi publik berdasarkan ID Akun + PIN Hash
        window.connectToCloudDocument = async function (docKey, showNotification = true) {
            if (!db || !currentUser) {
                if (showNotification) {
                    showToast("Menyiapkan koneksi Cloud... Pastikan terhubung ke internet.");
                }
                return;
            }

            if (activeUnsubscribe) {
                activeUnsubscribe();
                activeUnsubscribe = null;
            }

            // RULE 1: Strict Paths (/artifacts/{appId}/public/data/{collectionName}/{docId})
            const accountDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'synced_workspaces', docKey);

            try {
                const snap = await getDoc(accountDocRef);
                if (snap.exists()) {
                    const cloudData = snap.data();
                    if (cloudData && cloudData.payloadJson) {
                        const remoteState = JSON.parse(cloudData.payloadJson);
                        applyRemoteCloudState(remoteState);
                        if (showNotification) {
                            showToast(`Berhasil masuk ke Akun "${cloudAccountMeta.accountId}"! Data disinkronkan. ☁️`);
                        }
                    }
                } else {
                    // Akun baru: unggah data lokal saat ini ke Cloud
                    await window.pushStateToCloud(false);
                    if (showNotification) {
                        showToast(`Akun Cloud "${cloudAccountMeta.accountId}" berhasil dibuat & disinkronkan! ☁️`);
                    }
                }

                // Pasang pendengar Real-Time (onSnapshot) dengan callback error
                activeUnsubscribe = onSnapshot(
                    accountDocRef,
                    (docSnapshot) => {
                        if (!docSnapshot.exists()) return;
                        const data = docSnapshot.data();
                        if (!data || !data.payloadJson) return;

                        // Abaikan jika update berasal dari kiriman perangkat ini sendiri
                        if (data.updatedAt && data.updatedAt <= lastPushedTimestamp) return;

                        try {
                            const remoteState = JSON.parse(data.payloadJson);
                            const localTime = appState.lastSavedAt || 0;
                            const remoteTime = remoteState.lastSavedAt || data.updatedAt || 0;

                            if (remoteTime > localTime) {
                                applyRemoteCloudState(remoteState);
                            }
                        } catch (parseErr) {
                            console.error("Gagal memproses data sinkronisasi:", parseErr);
                        }
                    },
                    (error) => {
                        console.error("Real-time sync listener error:", error);
                    }
                );
            } catch (err) {
                console.error("Gagal menghubungkan akun Cloud:", err);
                if (showNotification) {
                    showToast("Gagal menghubungi Cloud, menggunakan penyimpanan lokal.");
                }
            }
        };

        window.stopCloudSubscription = function () {
            if (activeUnsubscribe) {
                activeUnsubscribe();
                activeUnsubscribe = null;
            }
        };

        window.pushStateToCloud = async function (manualNotify = false) {
            if (!db || !currentUser || !cloudAccountMeta.isConnected || !cloudAccountMeta.pinHash) return;
            if (isApplyingRemoteUpdate) return;

            try {
                syncActiveTimersRemaining();
                const now = Date.now();
                appState.lastSavedAt = now;
                lastPushedTimestamp = now;

                const accountDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'synced_workspaces', cloudAccountMeta.pinHash);
                await setDoc(accountDocRef, {
                    accountId: cloudAccountMeta.accountId,
                    updatedAt: now,
                    updatedByUid: currentUser.uid,
                    payloadJson: JSON.stringify(appState)
                });

                const lastSavedEl = document.getElementById('lastSavedTimeText');
                if (lastSavedEl) {
                    const timeStr = new Date(now).toLocaleTimeString('id-ID', {
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit'
                    });
                    lastSavedEl.textContent = `Tersinkron ke Cloud: ${timeStr}`;
                }

                if (manualNotify) {
                    showToast(`Data berhasil disimpan ke Akun Cloud "${cloudAccountMeta.accountId}"! ☁️`);
                }
            } catch (err) {
                console.error("Gagal mengunggah data ke Cloud:", err);
                if (manualNotify) {
                    showToast("Gagal mengunggah ke Cloud. Periksa koneksi internet.");
                }
            }
        };

        window.pullStateFromCloud = async function (manualNotify = false) {
            if (!db || !currentUser || !cloudAccountMeta.isConnected || !cloudAccountMeta.pinHash) return;

            try {
                const accountDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'synced_workspaces', cloudAccountMeta.pinHash);
                const snap = await getDoc(accountDocRef);
                if (snap.exists() && snap.data().payloadJson) {
                    const remoteState = JSON.parse(snap.data().payloadJson);
                    applyRemoteCloudState(remoteState);
                    if (manualNotify) {
                        showToast(`Data terbaru dari Akun "${cloudAccountMeta.accountId}" berhasil dimuat! ☁️`);
                    }
                } else if (manualNotify) {
                    showToast("Belum ada data tersimpan di Cloud untuk akun ini.");
                }
            } catch (err) {
                console.error("Gagal menarik data dari Cloud:", err);
                if (manualNotify) {
                    showToast("Gagal mengambil data dari Cloud.");
                }
            }
        };

        function applyRemoteCloudState(remoteState) {
            isApplyingRemoteUpdate = true;
            try {
                mergeLoadedState(remoteState);
                originalSavePersistentState(true);

                syncSoundButtonUI();
                syncPreventCloseUI();
                syncPresetButtonsUI();
                renderChecklistUI();
                renderHydrationUI();
                restoreDrinkTimerOnReload();
                restoreFocusTimerOnReload();

                const lastSavedEl = document.getElementById('lastSavedTimeText');
                if (lastSavedEl) {
                    const timeStr = new Date().toLocaleTimeString('id-ID', {
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit'
                    });
                    lastSavedEl.textContent = `Disinkronkan dari Cloud: ${timeStr}`;
                }
            } finally {
                setTimeout(() => {
                    isApplyingRemoteUpdate = false;
                }, 300);
            }
        }

        // Jalankan inisialisasi Cloud saat modul siap
        initFirebaseCloudSync();
    </script>
