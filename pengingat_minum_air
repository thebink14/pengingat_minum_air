        function updateTimerDisplay() {
            const totalSecs = Math.max(0, appState.timer.remainingSeconds);
            const hrs = Math.floor(totalSecs / 3600);
            const mins = Math.floor((totalSecs % 3600) / 60);
            const secs = totalSecs % 60;

            const formatted = `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            document.getElementById('countdownDisplay').textContent = formatted;

            const circle = document.getElementById('timerProgressCircle');
            const circumference = 263.89;
            const totalDuration = appState.timer.selectedDurationSeconds || 3600;
            const fraction = Math.min(1, Math.max(0, totalSecs / totalDuration));
            const offset = circumference - (fraction * circumference);
            circle.style.strokeDashoffset = offset;
        }

