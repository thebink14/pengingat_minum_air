<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Workspace Hidrasi & Fokus Kerja 💧🔥</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        cobalt: {
                            DEFAULT: '#0B63F6',
                            hover: '#0952CC',
                            light: '#EBF2FF',
                            border: '#C2D9FF'
                        },
                        offwhite: '#F4F4F4'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #F4F4F4;
            color: #0F172A;
            font-family: 'Inter', sans-serif;
        }
        /* Animasi gelombang air */
        .water-wave {
            transition: height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .wave-surface {
            background: linear-gradient(180deg, rgba(59, 130, 246, 0.45) 0%, rgba(11, 99, 246, 0.92) 100%);
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #F1F5F9;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94A3B8;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.98); box-shadow: 0 0 0 0 rgba(11, 99, 246, 0.55); }
            70% { transform: scale(1); box-shadow: 0 0 0 14px rgba(11, 99, 246, 0); }
            100% { transform: scale(0.98); box-shadow: 0 0 0 0 rgba(11, 99, 246, 0); }
        }
        .alarm-active {
            animation: pulse-ring 1.5s infinite;
        }
        .checkbox-custom:checked + div {
            text-decoration: line-through;
            color: #94A3B8;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between p-3 sm:p-5 lg:p-6">

    <!-- Kontainer Utama -->
    <div class="max-w-[1400px] w-full mx-auto space-y-5">
        
        <!-- Header Bar -->
        <header class="bg-white rounded-2xl p-4 md:px-6 shadow-sm border border-slate-200/80 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-cobalt text-white flex items-center justify-center shadow-md shadow-cobalt/25 flex-shrink-0">
                    <i data-lucide="layout-dashboard" class="w-6 h-6"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <h1 class="text-lg md:text-xl font-extrabold tracking-tight text-slate-900">Dashboard Kerja, Fokus & Hidrasi</h1>
                        <!-- Indikator Real-Time Auto-Save & Cloud Sync -->
                        <span id="saveStatusBadge" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 transition-transform" title="Tersimpan otomatis di Cloud & Perangkat">
                            <span id="saveStatusDot" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span id="saveStatusText">Auto-Save & Cloud Aktif</span>
                        </span>
                    </div>
                    <div class="flex items-center gap-3 mt-0.5 flex-wrap">
                        <p class="text-xs text-slate-500 font-medium" id="currentDateDisplay">Memuat tanggal...</p>
                        <span class="text-slate-300">•</span>
                        <p class="text-[11px] text-slate-500 font-semibold" id="lastSavedTimeText">Tersimpan otomatis: barusan</p>
                    </div>
                </div>
            </div>

            <!-- Kontrol Akun Cloud Sync, Pengaturan & Proteksi Keluar -->
            <div class="flex items-center gap-2 flex-wrap">
                <!-- Tombol Akun Cloud Sync (Ganti Device) -->
                <button id="btnCloudAccount" onclick="openAccountModal()" class="text-xs font-bold px-3.5 py-2 rounded-xl bg-cobalt text-white hover:bg-cobalt-hover shadow-sm shadow-cobalt/20 flex items-center gap-2 transition-all" title="Masuk atau hubungkan ID Akun agar sinkron di semua perangkat">
                    <i data-lucide="cloud" class="w-4 h-4"></i>
                    <span id="accountBadgeText">Akun Sync: Lokal</span>
                </button>

                <!-- Toggle Cegah Tertutup Tidak Sengaja -->
                <button id="btnPreventClose" onclick="togglePreventClose()" class="text-xs font-semibold px-3 py-2 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-700 flex items-center gap-1.5 transition-all" title="Munculkan peringatan konfirmasi jika tab tidak sengaja tertutup saat timer berjalan">
                    <i data-lucide="shield-alert" class="w-4 h-4"></i>
                    <span id="preventCloseText">Proteksi Tab: ON</span>
                </button>

                <!-- Tombol Notifikasi Desktop -->
                <button id="btnNotificationPerm" onclick="requestNotificationPermission()" class="text-xs font-semibold px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 flex items-center gap-1.5 transition-all">
                    <i data-lucide="bell" class="w-4 h-4 text-cobalt"></i>
                    <span id="notifStatusText">Notifikasi Desktop</span>
                </button>

                <!-- Tombol Suara -->
                <button id="btnSoundToggle" onclick="toggleMute()" class="text-xs font-semibold px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 flex items-center gap-1.5 transition-all" title="Bisu / Bunyikan Alarm">
                    <i data-lucide="volume-2" id="soundIcon" class="w-4 h-4 text-cobalt"></i>
                    <span id="soundStatusText">Suara ON</span>
                </button>

                <!-- Tombol Backup / Restore File JSON -->
                <button onclick="openBackupModal()" class="text-xs font-semibold px-3 py-2 rounded-xl bg-cobalt-light text-cobalt hover:bg-blue-100 transition-all flex items-center gap-1.5" title="Simpan cadangan data ke file atau pulihkan data">
                    <i data-lucide="database-backup" class="w-4 h-4"></i>
                    <span>Cadangkan Data</span>
                </button>
            </div>
        </header>

        <!-- GRID UTAMA 3 KOLOM DESKTOP -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
            
            <!-- KOLOM 1: CHECKLIST PERSIAPAN KERJA & TO-DO (4 KOLOM) -->
            <div class="lg:col-span-4 flex flex-col">
                <div class="bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-slate-200/80 flex-1 flex flex-col justify-between">
                    <div>
                        <!-- Header Checklist -->
                        <div class="flex items-start justify-between gap-2 mb-3">
                            <div>
                                <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                                    <i data-lucide="list-checks" class="w-3.5 h-3.5"></i> Ritual & Target Kerja
                                </span>
                                <h2 class="text-base md:text-lg font-extrabold text-slate-900 mt-1.5">Checklist Mulai Kerja</h2>
                                <p class="text-xs text-slate-500">Ceklis persiapan wajib sebelum mulai fokus kerja</p>
                            </div>
                            <button onclick="uncheckAllRoutineTasks()" class="text-[11px] font-bold px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center gap-1 transition-all flex-shrink-0" title="Reset tanda ceklis untuk sesi kerja baru tanpa menghapus daftar">
                                <i data-lucide="rotate-ccw" class="w-3.5 h-3.5 text-cobalt"></i>
                                Reset Ceklis
                            </button>
                        </div>

                        <!-- Progress Bar Checklist -->
                        <div class="bg-slate-50 rounded-2xl p-3.5 border border-slate-200/70 mb-4">
                            <div class="flex items-center justify-between text-xs mb-1.5">
                                <span id="checklistStatusTitle" class="font-bold text-slate-700">Progres Persiapan Kerja</span>
                                <span id="checklistProgressCount" class="font-extrabold text-cobalt">0/0 Selesai (0%)</span>
                            </div>
                            <div class="w-full h-2.5 bg-slate-200 rounded-full overflow-hidden">
                                <div id="checklistProgressBar" class="h-full bg-emerald-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                            </div>
                            <p id="checklistMotivationText" class="text-[11px] text-slate-500 mt-1.5 font-medium">
                                Selesaikan ritual awal kerjamu agar sesi hari ini lebih terarah!
                            </p>
                        </div>

                        <!-- Filter Tab Kategori Checklist -->
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <div class="flex items-center bg-slate-100 p-1 rounded-xl w-full">
                                <button id="tabChecklistRoutine" onclick="switchChecklistFilter('all')" class="flex-1 text-xs font-bold py-1.5 px-2 rounded-lg bg-white text-cobalt shadow-sm transition-all">
                                    Semua (<span id="badgeCountAllTasks">0</span>)
                                </button>
                                <button id="tabChecklistRitual" onclick="switchChecklistFilter('routine')" class="flex-1 text-xs font-semibold py-1.5 px-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all">
                                    Ritual Awal (<span id="badgeCountRoutineTasks">0</span>)
                                </button>
                                <button id="tabChecklistTodo" onclick="switchChecklistFilter('todo')" class="flex-1 text-xs font-semibold py-1.5 px-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all">
                                    Tugas (<span id="badgeCountTodoTasks">0</span>)
                                </button>
                            </div>
                        </div>

                        <!-- Form Tambah Item Checklist Baru -->
                        <form onsubmit="handleAddTask(event)" class="mb-3 space-y-2">
                            <div class="flex gap-1.5">
                                <input type="text" id="newTaskInput" placeholder="Tambah langkah kerja / tugas baru..." required
                                    class="flex-1 text-xs font-medium px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-cobalt focus:ring-2 focus:ring-cobalt/15 bg-slate-50/70">
                                <button type="submit" class="px-3.5 py-2.5 rounded-xl bg-cobalt hover:bg-cobalt-hover text-white font-bold text-xs flex items-center gap-1 shadow-sm transition-all flex-shrink-0">
                                    <i data-lucide="plus" class="w-4 h-4"></i>
                                    Tambah
                                </button>
                            </div>
                            <div class="flex items-center justify-between px-1">
                                <label class="inline-flex items-center gap-1.5 text-[11px] text-slate-600 font-medium cursor-pointer">
                                    <input type="radio" name="taskCategory" value="routine" checked class="text-cobalt focus:ring-cobalt">
                                    <span>Ritual Mulai Kerja (Tetap)</span>
                                </label>
                                <label class="inline-flex items-center gap-1.5 text-[11px] text-slate-600 font-medium cursor-pointer">
                                    <input type="radio" name="taskCategory" value="todo" class="text-cobalt focus:ring-cobalt">
                                    <span>Target / To-Do Hari Ini</span>
                                </label>
                            </div>
                        </form>

                        <!-- Daftar Item Checklist -->
                        <div id="checklistContainer" class="space-y-2 max-h-[340px] overflow-y-auto pr-1">
                            <!-- Diisi via JavaScript -->
                        </div>
                    </div>

                    <!-- Footer Checklist Actions -->
                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
                        <button onclick="restoreDefaultRoutineTasks()" class="hover:text-cobalt font-semibold flex items-center gap-1 transition-all">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Muat Template Standar
                        </button>
                        <button onclick="clearCompletedTodos()" class="hover:text-rose-600 font-semibold flex items-center gap-1 transition-all">
                            <i data-lucide="trash" class="w-3.5 h-3.5"></i> Bersihkan Tugas Selesai
                        </button>
                    </div>
                </div>
            </div>

            <!-- KOLOM 2: FOKUS MODE (2 JAM KERJA / 30 MENIT REST) & TIMER MINUM (1 JAM) (4 KOLOM) -->
            <div class="lg:col-span-4 flex flex-col gap-5">
                
                <!-- PANEL 2A: FOKUS MODE (120 MENIT KERJA / 30 MENIT REST) -->
                <div id="focusCardContainer" class="bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-slate-200/80 flex flex-col justify-between relative overflow-hidden transition-colors">
                    
                    <!-- Top Bar Fokus -->
                    <div class="flex items-center justify-between gap-2 mb-3">
                        <div id="focusModeBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                            <i data-lucide="flame" id="focusModeIcon" class="w-3.5 h-3.5 text-indigo-600"></i>
                            <span id="focusModeLabel">Mode Fokus Kerja (2 Jam)</span>
                        </div>

                        <div class="flex items-center gap-1">
                            <span class="text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700" title="Jumlah siklus fokus 2 jam yang diselesaikan hari ini">
                                🏆 <span id="focusSessionsTodayCount">0</span> Sesi
                            </span>
                            <button onclick="setFocusTest5Sec()" class="text-[11px] font-bold px-2 py-1 rounded-lg bg-amber-50 text-amber-700 hover:bg-amber-100 border border-amber-200 transition-all flex items-center gap-1" title="Tes bunyi & pergantian mode Fokus/Rest dalam 5 detik">
                                <i data-lucide="zap" class="w-3 h-3"></i> 5d
                            </button>
                        </div>
                    </div>

                    <!-- Switcher Mode Manual (Fokus 2 Jam vs Rest 30 Menit) -->
                    <div class="grid grid-cols-2 gap-1.5 bg-slate-100 p-1 rounded-xl mb-4">
                        <button id="btnSelectFocusMode" onclick="switchFocusPhase('work')" class="py-1.5 px-3 rounded-lg text-xs font-bold bg-white text-indigo-700 shadow-sm flex items-center justify-center gap-1.5 transition-all">
                            <i data-lucide="laptop" class="w-3.5 h-3.5"></i> Fokus (120 mnt)
                        </button>
                        <button id="btnSelectRestMode" onclick="switchFocusPhase('rest')" class="py-1.5 px-3 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 flex items-center justify-center gap-1.5 transition-all">
                            <i data-lucide="coffee" class="w-3.5 h-3.5"></i> Rest (30 mnt)
                        </button>
                    </div>

                    <!-- Tampilan Waktu Fokus/Rest -->
                    <div class="my-2 text-center">
                        <div id="focusCountdownDisplay" class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 tabular-nums">
                            02:00:00
                        </div>
                        <p id="focusNextInfoText" class="text-xs text-slate-500 mt-1 font-medium">
                            2 Jam kerja fokus lalu otomatis istirahat 30 menit
                        </p>

                        <!-- Progress Bar Horizontal Fokus -->
                        <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden mt-3 border border-slate-200/60">
                            <div id="focusProgressBar" class="h-full bg-indigo-600 rounded-full transition-all duration-300" style="width: 100%"></div>
                        </div>
                    </div>

                    <!-- Tombol Kontrol Fokus Mode -->
                    <div class="grid grid-cols-4 gap-2 mt-4">
                        <button id="btnFocusStartPause" onclick="toggleFocusTimer()" class="col-span-2 py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-md shadow-indigo-600/20 flex items-center justify-center gap-1.5 transition-all">
                            <i data-lucide="play" id="focusStartPauseIcon" class="w-4 h-4 fill-current"></i>
                            <span id="focusStartPauseText">Mulai Fokus</span>
                        </button>
                        <button onclick="skipFocusPhase()" class="py-2.5 px-2.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 font-semibold text-xs flex items-center justify-center gap-1 transition-all" title="Langsung pindah ke fase Fokus / Istirahat berikutnya">
                            <i data-lucide="skip-forward" class="w-3.5 h-3.5"></i> Lewati
                        </button>
                        <button onclick="resetFocusTimer()" class="py-2.5 px-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 font-semibold text-xs flex items-center justify-center gap-1 transition-all" title="Reset waktu fokus">
                            <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Reset
                        </button>
                    </div>
                </div>

                <!-- PANEL 2B: PENGINGAT MINUM AIR (1 JAM SEKALI) -->
                <div class="bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-slate-200/80 flex-1 flex flex-col justify-between relative overflow-hidden">
                    
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-cobalt-light text-cobalt" id="timerBadge">
                            <span class="w-2 h-2 rounded-full bg-cobalt" id="timerDot"></span>
                            <span id="timerStateLabel">Pengingat Minum (1 Jam)</span>
                        </div>

                        <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl">
                            <button onclick="setDuration(30)" class="preset-btn text-[11px] font-semibold px-2 py-1 rounded-lg text-slate-600 hover:text-slate-900 transition-all" data-minutes="30">30m</button>
                            <button onclick="setDuration(45)" class="preset-btn text-[11px] font-semibold px-2 py-1 rounded-lg text-slate-600 hover:text-slate-900 transition-all" data-minutes="45">45m</button>
                            <button onclick="setDuration(60)" class="preset-btn text-[11px] font-semibold px-2 py-1 rounded-lg bg-white text-cobalt shadow-sm transition-all" data-minutes="60">60m</button>
                            <button onclick="setTestAlarm()" class="preset-btn text-[11px] font-bold px-2 py-1 rounded-lg text-amber-600 hover:bg-amber-50 transition-all flex items-center gap-0.5" title="Tes alarm minum 5 detik">
                                <i data-lucide="zap" class="w-3 h-3"></i> 5d
                            </button>
                        </div>
                    </div>

                    <!-- Tampilan Timer Minum dengan Lingkaran Kompak -->
                    <div class="my-2 flex items-center justify-center gap-5">
                        <div class="relative w-28 h-28 flex items-center justify-center flex-shrink-0">
                            <svg class="w-full h-full -rotate-90 transform" viewBox="0 0 100 100">
                                <circle cx="50" cy="50" r="42" stroke="#F1F5F9" stroke-width="8" fill="transparent" />
                                <circle id="timerProgressCircle" cx="50" cy="50" r="42" stroke="#0B63F6" stroke-width="8" stroke-dasharray="263.89" stroke-dashoffset="0" stroke-linecap="round" fill="transparent" class="transition-all duration-300" />
                            </svg>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <i data-lucide="droplets" class="w-8 h-8 text-cobalt"></i>
                            </div>
                        </div>

                        <div class="flex-1">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Hitung Mundur Minum</span>
                            <div id="countdownDisplay" class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900 tabular-nums mt-0.5">
                                01:00:00
                            </div>
                            <p id="nextReminderText" class="text-xs text-slate-500 mt-1 font-medium">
                                Siap mengingatkan setiap 60 menit
                            </p>
                        </div>
                    </div>

                    <!-- Tombol Kontrol Timer Minum -->
                    <div class="grid grid-cols-3 gap-2 mt-4">
                        <button id="btnStartPause" onclick="toggleTimer()" class="col-span-2 py-2.5 px-4 rounded-xl bg-cobalt hover:bg-cobalt-hover text-white font-bold text-xs shadow-md shadow-cobalt/20 flex items-center justify-center gap-1.5 transition-all">
                            <i data-lucide="play" id="startPauseIcon" class="w-4 h-4 fill-current"></i>
                            <span id="startPauseText">Mulai Timer Minum</span>
                        </button>
                        <button onclick="resetTimer()" class="py-2.5 px-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs flex items-center justify-center gap-1.5 transition-all">
                            <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                            Reset
                        </button>
                    </div>
                </div>

            </div>

            <!-- KOLOM 3: PELACAK HIDRASI & RIWAYAT PERMANEN (4 KOLOM) -->
            <div class="lg:col-span-4 flex flex-col">
                <div class="bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-slate-200/80 flex-1 flex flex-col justify-between">
                    
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <div>
                                <h2 class="text-base font-extrabold text-slate-900">Target Hidrasi Harian</h2>
                                <p class="text-xs text-slate-500">Standar: <span id="cupSizeLabel" class="font-semibold text-slate-700">250 ml</span> / gelas</p>
                            </div>
                            <button onclick="openTargetModal()" class="text-xs font-semibold px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center gap-1.5 transition-all">
                                <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5 text-cobalt"></i>
                                Atur Target
                            </button>
                        </div>

                        <!-- Visualisasi Gelas Air & Statistik -->
                        <div class="bg-slate-50 rounded-2xl p-3.5 border border-slate-200/60 flex items-center gap-4 my-2">
                            <!-- Animasi Gelas -->
                            <div class="relative w-16 h-24 rounded-b-2xl rounded-t-md border-4 border-slate-300 bg-white overflow-hidden flex-shrink-0 shadow-inner">
                                <div id="waterFillElement" class="water-wave wave-surface absolute bottom-0 left-0 right-0 h-0"></div>
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <span id="waterPercentageText" class="text-[11px] font-extrabold text-slate-800 bg-white/90 px-1.5 py-0.5 rounded-md shadow-sm">0%</span>
                                </div>
                            </div>

                            <!-- Detail Capaian -->
                            <div class="flex-1">
                                <div class="flex items-baseline gap-1.5">
                                    <span id="glassCountDisplay" class="text-2xl md:text-3xl font-extrabold text-cobalt">0</span>
                                    <span class="text-xs font-semibold text-slate-400">/ <span id="targetGlassDisplay">8</span> Gelas</span>
                                </div>
                                <p class="text-xs font-semibold text-slate-600 mt-0.5">
                                    Hari Ini: <span id="mlCountDisplay" class="text-slate-900 font-bold">0</span> / <span id="targetMlDisplay">2000</span> ml
                                </p>
                                <p id="hydrationMotivation" class="text-[11px] text-slate-500 mt-1.5 leading-relaxed">
                                    Yuk mulai minum gelas pertamamu hari ini!
                                </p>
                            </div>
                        </div>

                        <!-- Tombol Cepat Tambah Minum -->
                        <div class="space-y-2 my-3">
